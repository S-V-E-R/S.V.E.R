APP_ENV=development
APP_ORIGIN=http://localhost:3000
SVER_DB_PASSWORD=generate-a-local-database-password
DATABASE_URL=postgres://sver_rebuild:YOUR_LOCAL_PASSWORD@localhost:15432/sver_rebuild
ENCRYPTION_KEY=BASE64_OF_32_RANDOM_BYTES
# Official Cloudflare development test keys; rejected in production.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET=1x0000000000000000000000000000000AA
# Set these only for authorized real email/provider testing or deployment.
RESEND_API_KEY=
MAIL_FROM=
# Optional: postal address at the foot of go-live alert emails. Defaults to the DMCA agent address on /dmca.
MAIL_POSTAL_ADDRESS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Linked chat from YouTube only (never sign-in): a separate Google project with the YouTube scope.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Optional: slowest YouTube chat read, in seconds (each read spends the daily API quota). Default 10.
YOUTUBE_POLL_SECONDS=
# Optional exact registered callbacks; defaults to APP_ORIGIN/api/auth/oauth/{provider}/callback.
# The sver.tv deployment preserves legacy https://api.sver.tv callbacks through a fixed redirect.
GOOGLE_REDIRECT_URI=
TWITCH_REDIRECT_URI=
DISCORD_REDIRECT_URI=
# Only when a trusted reverse proxy overwrites X-Real-IP:
TRUSTED_PROXY_IP=
# Take It Down cache removal: a token scoped to Cache Purge on the media site's Cloudflare zone.
# Local filesystem media needs neither value; production object storage requires both.
MEDIA_CLOUDFLARE_ZONE_ID=
MEDIA_CLOUDFLARE_PURGE_TOKEN=
# Staff Web Push: URL-safe base64 P-256 public/private VAPID keys, stored outside the repo.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:safety@sver.tv
# Optional isolated Module 3 media backend. Leave all unset to disable key actions.
# Use a separate rebuild media service; never point this at legacy ingest.
# STREAM_INGEST_URL=rtmp://127.0.0.1:19350/rebuild
# STREAM_SRS_API_URL=http://127.0.0.1:19850
# STREAM_HOOK_SECRET=GENERATE_32_OR_MORE_RANDOM_ASCII_CHARACTERS
# STREAM_HOOK_IP=127.0.0.1
# Optional public playback bases (HTTPS; plain http only for loopback in development).
# STREAM_HLS_URL=http://127.0.0.1:18081/rebuild
# STREAM_WHEP_URL=http://127.0.0.1:19851/rtc/v1/whep
# CDN in front of the HLS origin; playback URLs are then signed Bunny directory tokens.
# STREAM_CDN_URL=https://cdn.example/rebuild
# STREAM_CDN_TOKEN_KEY=THE_PULL_ZONE_TOKEN_AUTHENTICATION_KEY
# Header secret the CDN sends to the HLS origin (X-Sver-Origin); nginx refuses origin HLS without it.
# STREAM_ORIGIN_SECRET=GENERATE_32_OR_MORE_RANDOM_ASCII_CHARACTERS
# Measured direct-WebRTC limits (per broadcast, all broadcasts) from the load test; unset = no switching.
# STREAM_WEBRTC_PER_BROADCAST=
# STREAM_WEBRTC_GLOBAL=
# Optional extra ingest shown in Creator Studio.
# STREAM_WHIP_URL=https://stream.example/rebuild/whip/
# STREAM_SRT_URL=srt://stream.example:10081
# Restreaming: the media server's local RTMP app relays pull from; unset turns restreaming off.
# RESTREAM_SOURCE=rtmp://127.0.0.1:1936/rebuild
# RESTREAM_MAX=100
# Optional private viewer-integrity weights and thresholds (JSON); defaults are example values.
# INTEGRITY_TUNING_FILE=
# IPinfo Lite network data for viewer integrity (set both, or neither). Downloaded daily.
# IPINFO_TOKEN=
# IPINFO_DB=/var/lib/sver/ipinfo_lite.mmdb
# Module 8 recording storage is independent of public profile media.
# For local development only:
# VOD_STORAGE=filesystem
# VOD_DIR=C:/Users/YOUR_USER/SVER-dev/recordings
# VOD_SEGMENT_BASE=http://127.0.0.1:18081
# Production uses a separate PRIVATE S3-compatible bucket:
# VOD_STORAGE=s3
# VOD_S3_ENDPOINT=https://s3.example.test
# VOD_S3_BUCKET=private-recordings
# VOD_S3_REGION=auto
# VOD_S3_ACCESS_KEY_ID=
# VOD_S3_SECRET_ACCESS_KEY=
# VOD_TUNING_FILE=/run/sver/vods-tuning.json
# Module 9 Beacons share the private recording store. Uploads stay off in production until the
# known-abuse matching service is integrated; clip Beacons work without it.
# BEACON_UPLOADS=on
# BEACON_FONT_FILE=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf
# BEACON_TUNING_FILE=/run/sver/beacons-tuning.json

# API listen address (default 127.0.0.1:8080; keep it private behind the web server).
# BIND_ADDRESS=127.0.0.1:8080

# Public profile media (avatars, banners, emotes, fan art). Development defaults to the filesystem
# under %USERPROFILE%\SVER-dev; production needs S3-compatible storage. MEDIA_S3_PREFIX is optional
# and must end in '/', e.g. v2/.
# MEDIA_STORAGE=filesystem
# MEDIA_DIR=C:/Users/YOUR_USER/SVER-dev/media
# MEDIA_STORAGE=s3
# MEDIA_S3_ENDPOINT=https://s3.example.test
# MEDIA_S3_BUCKET=public-media
# MEDIA_S3_REGION=auto
# MEDIA_S3_ACCESS_KEY_ID=
# MEDIA_S3_SECRET_ACCESS_KEY=
# MEDIA_S3_PREFIX=
# MEDIA_PUBLIC_BASE=https://media.example.test

# Private tuning (JSON) outside the repository; config/*.example.json and the code hold safe examples.
# ENGAGEMENT_TUNING_FILE=
# FACTIONS_TUNING_FILE=
# MAGNET_TUNING_FILE=

# Payments (Module 6). Development and staging refuse live keys (sk_live_...).
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Discord bot for go-live posts and role sync; uses the Discord sign-in app's client ID and secret.
# DISCORD_BOT_TOKEN=
# GIFs in chat (KLIPY); unset turns GIFs off everywhere.
# KLIPY_APP_KEY=
# Channel emotes from other services, comma-separated: 7tv, bttv, ffz.
# OUTSIDE_EMOTES=7tv,bttv,ffz
# 1 = keep the game catalog in sync in the background.
# GAME_CATALOG_SYNC=1

# Legacy import tool only (sver-import-check): the legacy 2FA encryption key.
# LEGACY_TWO_FACTOR_ENCRYPTION_KEY=
