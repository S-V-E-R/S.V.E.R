APP_ENV=development
APP_ORIGIN=http://localhost:3000
SVER_DB_PASSWORD=generate-a-local-database-password
DATABASE_URL=postgres://sver_rebuild:YOUR_LOCAL_PASSWORD@localhost:15432/sver_rebuild
ENCRYPTION_KEY=BASE64_OF_32_RANDOM_BYTES
# Official Cloudflare development test keys; rejected in production.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET=1x0000000000000000000000000000000AA
# Set these only for authorized real email/provider testing or deployment.
RESEND_API_KEY=
MAIL_FROM=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Optional exact registered callbacks; defaults to APP_ORIGIN/api/auth/oauth/{provider}/callback.
# The sver.tv deployment preserves legacy https://api.sver.tv callbacks through a fixed redirect.
GOOGLE_REDIRECT_URI=
TWITCH_REDIRECT_URI=
DISCORD_REDIRECT_URI=
# Only when a trusted reverse proxy overwrites X-Real-IP:
TRUSTED_PROXY_IP=
# Take It Down cache removal: a token scoped to Cache Purge on the media site's Cloudflare zone.
# Local filesystem media needs neither value; production object storage requires both.
MEDIA_CLOUDFLARE_ZONE_ID=
MEDIA_CLOUDFLARE_PURGE_TOKEN=
# Staff Web Push: URL-safe base64 P-256 public/private VAPID keys, stored outside the repo.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:safety@sver.tv
# Optional isolated Module 3 media backend. Leave all unset to disable key actions.
# Use a separate rebuild media service; never point this at legacy ingest.
# STREAM_INGEST_URL=rtmp://127.0.0.1:19350/rebuild
# STREAM_SRS_API_URL=http://127.0.0.1:19850
# STREAM_HOOK_SECRET=GENERATE_32_OR_MORE_RANDOM_ASCII_CHARACTERS
# STREAM_HOOK_IP=127.0.0.1
# Optional public playback bases (HTTPS; plain http only for loopback in development).
# STREAM_HLS_URL=http://127.0.0.1:18081/rebuild
# STREAM_WHEP_URL=http://127.0.0.1:19851/rtc/v1/whep
# Optional private viewer-integrity weights and thresholds (JSON); defaults are example values.
# INTEGRITY_TUNING_FILE=
# Module 8 recording storage is independent of public profile media.
# For local development only:
# VOD_STORAGE=filesystem
# VOD_DIR=C:/Users/YOUR_USER/SVER-dev/recordings
# VOD_SEGMENT_BASE=http://127.0.0.1:18081
# Production uses a separate PRIVATE S3-compatible bucket:
# VOD_STORAGE=s3
# VOD_S3_ENDPOINT=https://s3.example.test
# VOD_S3_BUCKET=private-recordings
# VOD_S3_REGION=auto
# VOD_S3_ACCESS_KEY_ID=
# VOD_S3_SECRET_ACCESS_KEY=
# VOD_TUNING_FILE=/run/sver/vods-tuning.json
# Module 9 Beacons share the private recording store. Uploads stay off in production until the
# known-abuse matching service is integrated; clip Beacons work without it.
# BEACON_UPLOADS=on
# BEACON_FONT_FILE=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf
# BEACON_TUNING_FILE=/run/sver/beacons-tuning.json
